# 편집기(PyCharm) 설정
/.idea/

# 기획 중 화면 예시(브레인스토밍 도구가 만드는 파일)
/.superpowers/

# 파이썬 실행 환경과 시험 찌꺼기
/.venv/
__pycache__/
/.pytest_cache/

# 내 컴퓨터에서 키로 시험할 때 쓰는 환경변수 파일(키가 공개 저장소에 올라가지 않게)
.env

# 샘플 응답은 make_sample로 언제든 똑같이 다시 만들 수 있고 14MB라 넣지 않는다
/collector/sample/

# 글꼴 원본(Geist, 예전 영수증 글꼴). 만든 글꼴(fonts/)만 넣고 원본은 넣지 않는다
/tools/fonts-src/
